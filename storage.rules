rules_version = '2';
// Requires Blaze: rules call Firestore to bind Storage paths to team membership.
// https://firebase.google.com/docs/storage/security/rules-conditions#enhance_with_firestore
service firebase.storage {
  match /b/{bucket}/o {

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isAdminUser() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'admin';
    }

    function memberOfTeamData(d) {
      return d.leaderId == request.auth.uid
        || (
          'memberIds' in d
          && d.memberIds is list
          && request.auth.uid in d.memberIds
        );
    }

    function isTeamMemberForSubmission(teamId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/teams/$(teamId))
        && memberOfTeamData(
          firestore.get(/databases/(default)/documents/teams/$(teamId)).data
        );
    }

    // CRIT-01 fix: allowlist content types to prevent malicious file uploads.
    // Only PPT/PPTX, PDF, and video files are accepted for submission uploads.
    function isAllowedSubmissionContentType() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/vnd\\.ms-powerpoint')
        || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\.presentationml\\..*')
        || request.resource.contentType.matches('video/.*');
    }

    match /submissions/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && isAllowedSubmissionContentType();
    }

    // ─── Chat file attachments (photos, PDFs, PPTs — no videos) ──────
    // Max 35 MB per file. Used by team chat and mentor-participant chat.
    function isAllowedChatFileContentType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/vnd\\.ms-powerpoint')
        || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*')
        || request.resource.contentType.matches('application/msword')
        || request.resource.contentType.matches('application/vnd\\.ms-excel')
        || request.resource.contentType.matches('text/plain');
    }

    match /chatFiles/{teamId}/{allPaths=**} {
      allow read: if isTeamMemberForSubmission(teamId) || isAdminUser();
      allow write: if isTeamMemberForSubmission(teamId)
        && request.resource.size < 35 * 1024 * 1024
        && isAllowedChatFileContentType();
    }

    match /mentorChatFiles/{teamId}/{allPaths=**} {
      allow read: if isTeamMemberForSubmission(teamId) || isAdminUser();
      allow write: if (isTeamMemberForSubmission(teamId) || isAdminUser())
        && request.resource.size < 35 * 1024 * 1024
        && isAllowedChatFileContentType();
    }

    match /certificates/{allPaths=**} {
      allow read, write: if false;
    }

    // Patron images (admin upload only, public read)
    match /patrons/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminUser()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Sponsor logos (admin upload only, public read)
    match /sponsors/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminUser()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /media/{allPaths=**} {
      allow read, write: if false;
    }

    match /documents/{allPaths=**} {
      allow read, write: if false;
    }

    // LOW-06 fix: explicit catch-all deny for any path not matched above.
    // Firebase Storage defaults to deny, but this makes it explicit and future-proof.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
