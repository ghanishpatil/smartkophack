rules_version = '2';
// Debug version - more permissive for testing
service firebase.storage {
  match /b/{bucket}/o {

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isAdminUser() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'admin';
    }

    function teamDoc(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId));
    }

    function teamExists(teamId) {
      return firestore.exists(/databases/(default)/documents/teams/$(teamId));
    }

    function memberOfTeamData(d) {
      return d.leaderId == request.auth.uid
        || (
          'memberIds' in d
          && d.memberIds is list
          && request.auth.uid in d.memberIds
        );
    }

    function isTeamMemberForSubmission(teamId) {
      return request.auth != null
        && teamExists(teamId)
        && memberOfTeamData(teamDoc(teamId).data);
    }

    // Content type validation
    function isAllowedSubmissionContentType() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('application/vnd\\.ms-powerpoint')
        || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\.presentationml\\..*')
        || request.resource.contentType.matches('video/.*');
    }

    // TEMPORARY DEBUG: More permissive - any authenticated user can upload
    // This helps identify if the issue is with team membership check or something else
    match /submissions/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && isAllowedSubmissionContentType();
    }

    // Chat files - keep more permissive for now
    match /chatFiles/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 35 * 1024 * 1024;
    }

    match /mentorChatFiles/{teamId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 35 * 1024 * 1024;
    }

    match /certificates/{allPaths=**} {
      allow read, write: if false;
    }

    match /media/{allPaths=**} {
      allow read, write: if false;
    }

    match /documents/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
